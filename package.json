{
  "name": "a-list",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "typecheck:watch": "turbo watch typecheck --filter=a-list",
    "dev": "cd src && bun run dev",
    "deploy": "pulumi up --stack prod -y",
    "deploy:dev": "pulumi up --stack dev -y",
    "cancel-deploy": "pulumi cancel -s prod --yes",
    "cancel-deploy:dev": "pulumi cancel -s dev --yes"
  },
  "devDependencies": {
    "@types/bun": "catalog:dev"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@pulumi/aws": "catalog:infra",
    "@pulumi/pulumi": "catalog:infra",
    "@whiskey/api": "workspace:*",
    "@whiskey/pulumi-opennext-site": "workspace:*",
    "@whiskey/pulumi-utils": "workspace:*"
  }
}
